# Copy the values you need into your host's environment settings.
# Nothing here requires a paid service.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com

# PostgreSQL (enables full-text search). Leave unset to use SQLite.
# DATABASE_URL=postgres://user:password@host:5432/sibuyanconnect

# Email: console backend prints emails; use any SMTP account you already have.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=lgu.account@gmail.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=SibuyanConnect <lgu.account@gmail.com>

# Optional SMS hook (off by default). Test with the console stand-in:
# SMS_BACKEND=core.notify.console_sms_backend

# Optional help-assistant LLM layer: none | gemini | ollama
ASSISTANT_LLM_BACKEND=none
# GEMINI_API_KEY=free-key-from-aistudio.google.com   (free tier, no billing account)
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
